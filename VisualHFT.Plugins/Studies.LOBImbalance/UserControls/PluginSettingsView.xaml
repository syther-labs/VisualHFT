<UserControl x:Class="VisualHFT.Studies.LOBImbalance.UserControls.PluginSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisualHFT.Studies.LOBImbalance.UserControls"
             mc:Ignorable="d" >
    <Grid Margin="10">
        <StackPanel>
            <Label Content="Provider" Margin="0,0"/>
            <ComboBox Margin="0,5"
                      ItemsSource="{Binding Path=Providers}" 
                      SelectedItem="{Binding SelectedProvider, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                      DisplayMemberPath="ProviderName" FontSize="18" />

            <Label Content="Symbol"/>
            <ComboBox FontSize="18" Margin="0,5"
                      ItemsSource="{Binding Symbols}" 
                      SelectedItem="{Binding SelectedSymbol, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>


            <Label Content="Aggregation"/>
            <ComboBox ItemsSource="{Binding AggregationLevels}" Margin="0,5"
                  DisplayMemberPath="Item1"
                  SelectedValuePath="Item2"
                  SelectedValue="{Binding AggregationLevelSelection, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  FontSize="18"/>

            <StackPanel Orientation="Horizontal">
                <Label Content="Weighting"/>
                <TextBlock x:Name="WeightingInfoIcon" Text="ℹ️" Cursor="Hand" Margin="10 5 0 0">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="360">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold">Equal Weight</Run> (default)<LineBreak/>
                                    <Run>Every captured price level counts its full size, no matter how far it is from the best price.</Run>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                                    <Run FontWeight="Bold">Touch Weighted</Run><LineBreak/>
                                    <Run>Levels closer to the best price count more; levels farther away count less. Internal research shows this predicts the next short-term price move better than Equal Weight.</Run>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>
            <ComboBox x:Name="WeightingComboBox" ItemsSource="{Binding Weightings}" Margin="0,5"
                  DisplayMemberPath="Item1"
                  SelectedValuePath="Item2"
                  SelectedValue="{Binding WeightingSelection, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  FontSize="18"/>



            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                <Label Content="{Binding ValidationMessage}" Foreground="Red" HorizontalAlignment="Left" Margin="0 0 20 0" />
                <Button Content="OK" Command="{Binding OkCommand}" Margin="0,0,5,0" Width="80" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
