<UserControl x:Class="VisualHFT.Studies.MarketRatios.UserControls.PluginSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VisualHFT.Studies.MarketRatios.UserControls"
             mc:Ignorable="d" >
    <Grid Margin="10">
        <StackPanel>
            <Label Content="Provider" Margin="0,0"/>
            <ComboBox Margin="0,5"
                      ItemsSource="{Binding Path=Providers}" 
                      SelectedItem="{Binding SelectedProvider, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}" 
                      DisplayMemberPath="ProviderName" FontSize="18" />

            <Label Content="Symbol"/>
            <ComboBox FontSize="18" Margin="0,5"
                      ItemsSource="{Binding Symbols}" 
                      SelectedItem="{Binding SelectedSymbol, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"/>


            <Label Content="Aggregation"/>
            <ComboBox ItemsSource="{Binding AggregationLevels}" Margin="0,5"
                  DisplayMemberPath="Item1" 
                  SelectedValuePath="Item2" 
                  SelectedValue="{Binding AggregationLevelSelection, ValidatesOnDataErrors=True, UpdateSourceTrigger=PropertyChanged}"
                  FontSize="18"/>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="UseVolumeFormCheckBox"
                          Content="Use volume form (size posted vs size executed)"
                          IsChecked="{Binding UseVolumeFormSelection, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center"/>
                <TextBlock x:Name="VolumeFormInfoIcon" Text="&#x2139;&#xFE0F;" Cursor="Hand" Margin="10 0 0 0" VerticalAlignment="Center">
                    <TextBlock.ToolTip>
                        <ToolTip MaxWidth="360">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="Bold">Message-count form</Run> (default)<LineBreak/>
                                    <Run>Counts book changes against trades over each aggregation window. Both sides are message counts, not size.</Run>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                                    <Run FontWeight="Bold">Volume form</Run><LineBreak/>
                                    <Run>Measures size posted against size executed: ordered volume divided by traded volume, minus one. This is the shape the EU regulatory technical standard for order-to-trade ratios (RTS 9) uses, applied to public market data — it is not a venue's per-member regulatory ratio. Totals accumulate from the moment the study starts and reset at the daily rollover.</Run>
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                                    <Run>Changing this restarts the study, which clears the totals it has collected so far.</Run>
                                </TextBlock>
                            </StackPanel>
                        </ToolTip>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10">
                <Label Content="{Binding ValidationMessage}" Foreground="Red" HorizontalAlignment="Left" Margin="0 0 20 0" />
                <Button Content="OK" Command="{Binding OkCommand}" Margin="0,0,5,0" Width="80" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" Width="80" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
